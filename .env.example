# ==============================================================================
# AIMS EMS - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials or secret keys to version control.
# In production, configure these variables in the Vercel Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string for application runtime queries (Server Actions, Route Handlers)
DATABASE_URL="postgresql://aims_user:sample_password@ep-silent-pooler.us-east-2.aws.neon.tech/aims_db?sslmode=require"

# Direct connection string for Drizzle migrations (bypasses PgBouncer pooling)
DIRECT_DATABASE_URL="postgresql://aims_user:sample_password@ep-silent.us-east-2.aws.neon.tech/aims_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & IDENTITY (Clerk)
# ------------------------------------------------------------------------------
# Public Clerk Publishable Key (safe for browser exposure)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_publishable_key"

# Private Clerk Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
CLERK_SECRET_KEY="sk_test_sample_clerk_secret_key"

# Clerk Route Redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/profile"

# ------------------------------------------------------------------------------
# 3. OPTIONAL SERVICES (Uncomment when required in future roadmap milestones)
# ------------------------------------------------------------------------------
# Sentry Error Monitoring
# SENTRY_DSN="https://sample_key@o000000.ingest.sentry.io/0000000"

# Resend Transactional Email
# RESEND_API_KEY="re_sample_resend_api_key"

# Cloudflare R2 / Cloudinary Object Storage
# R2_ACCOUNT_ID="sample_account_id"
# R2_ACCESS_KEY_ID="sample_access_key"
# R2_SECRET_ACCESS_KEY="sample_secret_key"
# R2_BUCKET_NAME="aims-ems-assets"
